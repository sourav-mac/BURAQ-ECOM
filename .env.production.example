# BURAQ backend API URL (Render Production Backend)
NEXT_PUBLIC_API_URL=https://buraq-backend.onrender.com/api/v1

# NextAuth URL - set to your Vercel deployment URL
NEXTAUTH_URL=https://buraq-ecom.vercel.app

# NextAuth Secret
NEXTAUTH_SECRET=buraq_enterprise_super_secret_jwt_key_2026_secured

# Google OAuth Credentials (replace with your credentials in Vercel settings)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
